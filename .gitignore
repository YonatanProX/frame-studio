# Frame Studio — what never goes into the repository.
# Check what would be published with:  node tools/list-publishable.mjs

# ── personal: projects, media, exports, local settings ───────────────────────
/projects/*
!/projects/.gitkeep
/config.json
/config.json.bak
/library/sources.json
exports/
snapshots/

# ── licensed audio: Sonniss / Mixkit / your own sounds may NOT be redistributed ─
# (see library/sounds/README.md — every user downloads them personally)
/library/sounds/*
!/library/sounds/README.md
/library/sounds/index.json
.peaks/

# ── logs, caches, temp files ──────────────────────────────────────────────────
server.log
server.old.log
*.log
*.tmp
*.temp
*.bak
__pycache__/
*.py[cod]
node_modules/

# ── browser profiles (headless render workers, screenshots, app window) ──────
.chrome-render*/
.chrome-profile*/
chrome-profile*/
*chrome-prof*/
fs-shot-*/

# ── release builds (node tools/make-release.mjs) ─────────────────────────────
/dist/

# ── test outputs and generated test media ────────────────────────────────────
/tools/tests/*-out/
/tools/tests/*-assets/
/tools/tests/*-tmp/
/tools/tests/U-media/

# ── OS / editor clutter ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
.claude/settings.local.json
